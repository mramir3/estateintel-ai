# OpenRouter API Key (Required for live LLM responses)
# Obtain a free key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Free Model configuration (Verified free models on OpenRouter)
# Options: openrouter/free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=openrouter/free

# Application Environment
ENVIRONMENT=production
PORT=8501
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
TEMPERATURE=0.2
MAX_TOKENS=1024
TOP_K_RESULTS=5
REQUEST_TIMEOUT=30
